# Copie para .env e ajuste. Nenhuma credencial secreta deve ir para este arquivo.
# Homologação (padrão): selos de pendência visíveis + noindex.
PUBLIC_STAGING=true
# Endpoint público que aceita POST multipart/form-data e responde JSON 2xx (ex.: Formspree/Web3Forms/função própria).
# Deixe vazio enquanto a integração não for aprovada — o formulário oferecerá WhatsApp/e-mail.
PUBLIC_LEAD_ENDPOINT=
