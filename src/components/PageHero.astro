---
import CutLine from './CutLine.astro';
/** Abertura das páginas internas: trilha de navegação, título editorial e imagem opcional. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  lead?: string;
  crumb: string;
  /** nível intermediário da trilha (ex.: Produtos) */
  parent?: { label: string; href: string };
  image?: ImageMetadata;
  alt?: string;
  imagePos?: string;
}
const { eyebrow, title, accent, lead, crumb, parent, image, alt = '', imagePos = '50% 50%' } = Astro.props;
const parts = accent && title.includes(accent) ? title.split(accent) : null;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).toString() },
    ...(parent ? [{ '@type': 'ListItem', position: 2, name: parent.label, item: new URL(parent.href, Astro.site).toString() }] : []),
    { '@type': 'ListItem', position: parent ? 3 : 2, name: crumb, item: new URL(Astro.url.pathname, Astro.site).toString() },
  ],
};
---
<section class:list={['ph', image && 'ph-img']} aria-labelledby="t-page">
  <div class="container-x ph-grid">
    <div class="ph-text">
      <nav aria-label="Trilha de navegação" class="crumbs">
        <ol>
          <li><a href="/">Início</a></li>
          {parent && <li><a href={parent.href}>{parent.label}</a></li>}
          <li aria-current="page">{crumb}</li>
        </ol>
      </nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="t-page" class="display display-lg kinetic" data-auto>
        <span class="line"><span>{parts ? <>{parts[0]}<span class="g">{accent}</span>{parts[1]}</> : title}</span></span>
      </h1>
      {lead && <p class="lead ph-lead" data-auto-fade style="--delay:300ms">{lead}</p>}
      <slot />
    </div>
    {image && (
      <figure class="ph-media cut cut-bl" data-wipe>
        <Picture src={image} formats={['avif', 'webp']} widths={[560, 900, 1300]} sizes="(min-width: 64rem) 45vw, 100vw" alt={alt} loading="eager" fetchpriority="high" style={`object-position:${imagePos}`} />
        <CutLine shape="bl" />
      </figure>
    )}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
</section>

<style>
  .ph { padding-top: clamp(1.5rem, 4vw, 3rem); }
  .ph-grid { display: grid; gap: 2.5rem; padding-bottom: clamp(3rem, 6vw, 5rem); }
  @media (min-width: 64rem) {
    .ph-img .ph-grid { grid-template-columns: 1.1fr 1fr; gap: 4rem; align-items: end; }
  }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0 0 2rem; padding: 0; font-size: 0.875rem; color: var(--color-ink-3); }
  .crumbs li + li::before { content: "/"; margin-right: 0.5rem; color: var(--color-line); }
  .crumbs a { color: var(--color-ink-2); }
  h1 { margin-top: 1.25rem; color: var(--color-blue-700); max-width: 14ch; }
  .g { color: var(--color-green-700); }
  .ph-lead { margin-top: 1.5rem; max-width: 44ch; }
  .ph-media { --chamfer: clamp(28px, 4vw, 56px); margin: 0; }
  .ph-media :global(img) { width: 100%; height: auto; aspect-ratio: 1.25; object-fit: cover; }
  .ph-flute { display: block; height: 26px; }
</style>
