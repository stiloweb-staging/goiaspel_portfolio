---
/**
 * Vídeo do YouTube carregado só no clique (youtube-nocookie). Nenhuma requisição a terceiros
 * antes da interação: melhor desempenho e privacidade (sem cookies até o play).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { id: string; title: string; poster: ImageMetadata; posterAlt?: string }
const { id, title, poster } = Astro.props;
---
<div class="vf chamfer" data-video={id} data-title={title}>
  <Picture src={poster} formats={['avif', 'webp']} widths={[480, 900]} sizes="(min-width: 64rem) 45vw, 92vw" alt="" loading="lazy" class="vf-poster" />
  <button type="button" class="vf-btn">
    <span class="vf-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
    <span class="vf-label">Assistir: {title}</span>
  </button>
</div>

<style>
  .vf { --chamfer: 32px; position: relative; aspect-ratio: 16 / 9; background: var(--color-ink); overflow: hidden; }
  .vf :global(.vf-poster) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.9; transition: opacity var(--dur-2), transform 900ms var(--ease-out-quart); }
  .vf-btn {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 0.75rem;
    padding: 1.5rem;
    background: linear-gradient(transparent 40%, rgb(11 31 69 / 0.85));
    border: 0; cursor: pointer; color: var(--color-white); text-align: left; font: inherit;
  }
  /* centralizado: cobre o ícone de play que já vem desenhado nas capas originais */
  .vf-play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: grid; place-items: center; width: clamp(5rem, 10vw, 7.5rem); height: clamp(5rem, 10vw, 7.5rem); background: var(--gp-verde); clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%); transition: transform var(--dur-2) var(--ease-out-quart); }
  .vf-play svg { width: 2rem; height: 2rem; }
  .vf-label { font-weight: 700; font-size: 1.125rem; }
  .vf:hover :global(.vf-poster) { opacity: 0.85; transform: scale(1.03); }
  .vf:hover .vf-play { transform: scale(1.06); }
  .vf :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.video}?autoplay=1&rel=0`;
      iframe.title = box.dataset.title ?? 'Vídeo';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
