---
/**
 * Fio do recorte (estilo da apresentação, p. 2, 3 e 10): linha fina paralela ao corte diagonal,
 * do lado de fora da imagem. Usar dentro de <figure class="cut cut-{shape}">, depois da mídia.
 * Coordenadas em % da figura (viewBox 0–100, sem preservar proporção): paralelas continuam paralelas.
 */
interface Props { shape: 'bl' | 'tr' | 'tl' | 'slant' }
const { shape } = Astro.props;
const lines = {
  bl: { x1: -2.2, y1: 66.6, x2: 27.4, y2: 102.2 },
  tr: { x1: 70.6, y1: -2.2, x2: 102.2, y2: 33.4 },
  tl: { x1: -2.2, y1: 33.4, x2: 27.4, y2: -2.2 },
} as const;
---
<svg class="cut-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  {shape === 'slant'
    ? <polyline points="12.6,-1.6 -1.6,101.6" pathLength="1" />
    : <line {...lines[shape]} pathLength="1" />}
</svg>
