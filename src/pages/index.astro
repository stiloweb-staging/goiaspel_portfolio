<script>
  // Fila de produtos: embaralha a ordem a cada visita e duplica a lista para o loop contínuo.
  document.querySelectorAll<HTMLElement>('[data-ps]').forEach((box) => {
    const track = box.querySelector<HTMLElement>('[data-ps-track]')!;
    const items = [...track.children];
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    track.replaceChildren(...items);
    items.forEach((li) => {
      const c = li.cloneNode(true) as HTMLElement;
      c.setAttribute('aria-hidden', 'true');
      c.querySelector('img')?.setAttribute('alt', '');
      track.append(c);
    });
    box.style.setProperty('--ps-dur', `${items.length * 3}s`); // ~3 s por embalagem: passagem lenta
    box.classList.add('is-ready');
  });
</script>
